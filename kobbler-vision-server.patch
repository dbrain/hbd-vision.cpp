+# fetch <repo> <file> -> echoes the local path on success, nothing on failure.
+fetch() {
+    repo="$1"
+    file="$2"
+    dest="${MODELS_DIR}/${file}"
+    if [ -f "${dest}" ]; then
+        echo "[vision] cache hit: ${dest}" >&2
+        echo "${dest}"
+        return 0
+    fi
+    if [ -z "${repo}" ]; then
+        return 0
+    fi
+    url="https://huggingface.co/${repo}/resolve/main/${file}"
+    echo "[vision] fetching ${url}" >&2
+    if curl -fL --retry 5 --retry-delay 2 -C - -o "${dest}.partial" "${url}"; then
+        mv "${dest}.partial" "${dest}"
+        echo "${dest}"
+    else
+        rm -f "${dest}.partial"
+        echo "[vision] WARNING: could not fetch ${file} from ${repo}" >&2
+    fi
+}
+
+MODEL_PATH="$(fetch "${MATTING_HF_REPO:-gobeldan/RMBG-2.0-GGUF}" "${MATTING_MODEL_FILE:-RMBG-2.0-F16.gguf}")"

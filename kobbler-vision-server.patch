+DEPTH3_MODEL_PATH="$(fetch "${DEPTH3_HF_REPO:-}" "${DEPTH3_MODEL_FILE:-Depth-Anything-3-Small-F16.gguf}")"
+SIGLIP_MODEL_PATH="$(fetch "${SIGLIP_HF_REPO:-}" "${SIGLIP_MODEL_FILE:-siglip2.gguf}")"
+SIGLIP_TOKENIZER_PATH="$(fetch "${SIGLIP_HF_REPO:-}" "${SIGLIP_TOKENIZER_FILE:-tokenizer.model}")"
 
-export MODEL_PATH="${MODEL_PATH}"
+export MODEL_PATH DEPTH_MODEL_PATH DEPTH3_MODEL_PATH SIGLIP_MODEL_PATH SIGLIP_TOKENIZER_PATH
 
-echo "[matting] starting server on ${HOST:-0.0.0.0}:${PORT:-8898} backend=${MATTING_BACKEND:-auto}"
-exec /usr/local/bin/matting-server "$@"
+echo "[vision] matting=${MODEL_PATH:-<none>} depth-v2=${DEPTH_MODEL_PATH:-<none>} depth-3=${DEPTH3_MODEL_PATH:-<none>} siglip=${SIGLIP_MODEL_PATH:-<none>}"
+echo "[vision] starting server on ${HOST:-0.0.0.0}:${PORT:-8898} backend=${MATTING_BACKEND:-auto}"
+exec /usr/local/bin/vision-server "$@"
